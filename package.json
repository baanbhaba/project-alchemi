{
  "name": "project-alchemi",
  "private": true,
  "version": "1.0.0",
  "description": "ALCHEMI — Automated Legacy Code Transformation Engine (Java to Rust)",
  "homepage": "https://acme.com/alchemi",
  "author": {
    "name": "ALCHEMI Team",
    "email": "dev@alchemi.ai"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "scripts": {
    "dev": "vite",
    "postinstall": "prisma generate",
    "build": "prisma generate && tsc -b && vite build",
    "db:seed": "node prisma/seed.mjs",
    "db:reset": "prisma migrate reset --force && node prisma/seed.mjs",
    "test": "vitest run",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:linux": "rm -rf dist-desktop && npm run build && electron-builder --linux AppImage tar.gz",
    "electron:build:win": "rm -rf dist-desktop && npm run build && electron-builder --win nsis portable"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sentry/react": "^10.70.0",
    "@tanstack/react-query": "^5.101.4",
    "@types/jszip": "^3.4.0",
    "@types/pg": "^8.20.4",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.0",
    "gifuct-js": "^2.1.2",
    "jszip": "^3.10.1",
    "lucide-react": "^1.28.0",
    "mermaid": "^11.16.0",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.9.5",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.alchemi.transformation",
    "productName": "ALCHEMI Legacy Code Transformation Engine",
    "executableName": "alchemi-ui",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "linux": {
      "executableName": "alchemi-ui",
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "maintainer": "dev@alchemi.ai",
      "category": "Development"
    },
    "win": {
      "executableName": "alchemi-ui",
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
