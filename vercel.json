{
  "name": "project-alchemi",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/nvidia-api/:path*",
      "destination": "https://integrate.api.nvidia.com/v1/:path*"
    },
    {
      "source": "/aiml-api/:path*",
      "destination": "https://api.aimlapi.com/v1/:path*"
    },
    {
      "source": "/api/v1/ai/chat",
      "destination": "/api/ai/chat"
    },
    {
      "source": "/api/v1/analyze/core",
      "destination": "/api/analyze/core"
    },
    {
      "source": "/api/v1/analyze/impact",
      "destination": "/api/analyze/impact"
    },
    {
      "source": "/api/v1/auth/login",
      "destination": "/api/auth/login"
    },
    {
      "source": "/api/v1/projects/:id/blueprint/steps/:stepId/approve",
      "destination": "/api/projects/:id?route=step-approve&stepId=:stepId"
    },
    {
      "source": "/api/v1/projects/:id/blueprint/steps/:stepId/reject",
      "destination": "/api/projects/:id?route=step-reject&stepId=:stepId"
    },
    {
      "source": "/api/v1/projects/:id/blueprint/steps/:stepId",
      "destination": "/api/projects/:id?route=step-patch&stepId=:stepId"
    },
    {
      "source": "/api/v1/projects/:id/blueprint/approve-all",
      "destination": "/api/projects/:id?route=blueprint-approve-all"
    },
    {
      "source": "/api/v1/projects/:id/blueprint",
      "destination": "/api/projects/:id?route=blueprint"
    },
    {
      "source": "/api/v1/projects/:id/readiness",
      "destination": "/api/projects/:id?route=readiness"
    },
    {
      "source": "/api/v1/projects/:id/consensus",
      "destination": "/api/projects/:id?route=consensus"
    },
    {
      "source": "/api/v1/projects/:id/report",
      "destination": "/api/projects/:id?route=report"
    },
    {
      "source": "/api/v1/projects/:id/transform",
      "destination": "/api/projects/:id?route=transform"
    },
    {
      "source": "/api/v1/projects/:id/audit",
      "destination": "/api/projects/:id?route=audit"
    },
    {
      "source": "/api/v1/projects/:id/upload",
      "destination": "/api/projects/:id?route=upload"
    },
    {
      "source": "/api/v1/projects/:id",
      "destination": "/api/projects/:id"
    },
    {
      "source": "/api/v1/projects",
      "destination": "/api/projects"
    },
    {
      "source": "/api/v1/auth/oauth/google",
      "destination": "/api/auth/oauth/google"
    },
    {
      "source": "/api/auth/oauth/google",
      "destination": "/api/auth/oauth/google"
    },
    {
      "source": "/api/v1/auth/oauth/callback",
      "destination": "/api/auth/oauth/callback"
    },
    {
      "source": "/api/auth/oauth/callback",
      "destination": "/api/auth/oauth/callback"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "/api/404"
    },
    {
      "source": "/((?!api/|assets/|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}
